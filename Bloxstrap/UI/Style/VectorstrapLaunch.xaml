<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VectorstrapSurfaceBrush" Color="#121212" />
    <SolidColorBrush x:Key="VectorstrapTileBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="VectorstrapTileHoverBrush" Color="#282828" />
    <SolidColorBrush x:Key="VectorstrapLinkBrush" Color="#D080FF" />
    <SolidColorBrush x:Key="VectorstrapMutedBrush" Color="#A0A0A0" />

    <LinearGradientBrush x:Key="VectorstrapLogoGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#5CE1FF" />
        <GradientStop Offset="1" Color="#0066FF" />
    </LinearGradientBrush>

    <Style x:Key="VectorstrapLaunchTile" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource VectorstrapTileBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="TileBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TileBorder" Property="Background" Value="{StaticResource VectorstrapTileHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TileBorder" Property="Opacity" Value="0.92" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VectorstrapSideLink" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource VectorstrapLinkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#E8B4FF" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
