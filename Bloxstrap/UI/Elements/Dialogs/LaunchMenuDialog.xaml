<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.LaunchMenuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
        xmlns:global="clr-namespace:Bloxstrap.UI.ViewModels"
        xmlns:resources="clr-namespace:Bloxstrap.Resources"
        xmlns:vm="clr-namespace:Bloxstrap.UI.ViewModels.Installer"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LaunchMenuViewModel}"
        Title="Vectorstrap"
        Width="640"
        SizeToContent="Height"
        MinHeight="420"
        ResizeMode="NoResize"
        Background="#121212"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterScreen">

    <Border Background="#121212" Padding="0,0,0,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0"
                         Padding="12,8"
                         ShowMinimize="False"
                         ShowMaximize="False"
                         CanMaximize="False"
                         Title="Vectorstrap"
                         Icon="pack://application:,,,/Vectorstrap.ico"
                         Background="#121212" />

            <Grid Grid.Row="1" Margin="20,8,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Branding column -->
                <Grid Grid.Column="0" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,8,16,0">
                        <controls:VectorstrapLogoMark HorizontalAlignment="Left" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding Version, Mode=OneTime}"
                                   FontSize="13"
                                   Foreground="{StaticResource VectorstrapMutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,24,16,0">
                        <Button Style="{StaticResource VectorstrapSideLink}"
                                Command="{Binding LaunchAboutCommand, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="QuestionCircle24" Margin="0,0,8,0" Foreground="{StaticResource VectorstrapLinkBrush}" />
                                <TextBlock Text="About vectorstrap" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource VectorstrapSideLink}"
                                Command="{x:Static global:GlobalViewModel.OpenWebpageCommand}"
                                CommandParameter="https://github.com/Cunzaki/Vectorstrap">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Book24" Margin="0,0,8,0" Foreground="{StaticResource VectorstrapLinkBrush}" />
                                <TextBlock Text="vectorstrap Wiki" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource VectorstrapSideLink}"
                                Command="{x:Static global:GlobalViewModel.OpenWebpageCommand}"
                                CommandParameter="https://www.roblox.com/community">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" Margin="0,0,8,0" Foreground="{StaticResource VectorstrapLinkBrush}" />
                                <TextBlock Text="Roblox Community" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Actions column -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button Style="{StaticResource VectorstrapLaunchTile}"
                            Command="{Binding LaunchRobloxCommand, Mode=OneTime}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Play24" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" FontSize="15" VerticalAlignment="Center" />
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{StaticResource VectorstrapMutedBrush}" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource VectorstrapLaunchTile}"
                            Command="{Binding LaunchRobloxStudioCommand, Mode=OneTime}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Wrench24" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}" FontSize="15" VerticalAlignment="Center" />
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{StaticResource VectorstrapMutedBrush}" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource VectorstrapLaunchTile}"
                            Command="{Binding LaunchSettingsCommand, Mode=OneTime}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Settings24" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.LaunchMenu_ConfigureSettings}" FontSize="15" VerticalAlignment="Center" />
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{StaticResource VectorstrapMutedBrush}" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource VectorstrapLaunchTile}"
                            Margin="0,8,0,0"
                            Command="{x:Static global:GlobalViewModel.OpenWebpageCommand}"
                            CommandParameter="https://github.com/Cunzaki/Vectorstrap#readme">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="BookQuestionMark24" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static resources:Strings.LaunchMenu_Wiki_Title}" FontSize="15" />
                                <TextBlock Text="{x:Static resources:Strings.LaunchMenu_Wiki_Description}"
                                           FontSize="12"
                                           Foreground="{StaticResource VectorstrapMutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{StaticResource VectorstrapMutedBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</base:WpfUiWindow>
